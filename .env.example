# ══════════════════════════════════════════════════════
# Bot PDV SEFAZ — Variáveis de Ambiente
# ══════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores.

# ── Discord ────────────────────────────────────────────
DISCORD_TOKEN=seu_token_aqui
CHANNEL_ID=id_do_canal_aqui

# ── Certificado Digital A1 ─────────────────────────────
# Caminho para o arquivo .pfx e senha
CERT_PATH=./certificado.pfx
CERT_PASSWORD=sua_senha_aqui

# ── Cargos Discord para menções (opcional) ─────────────
# Se preenchidos, substituem @everyone nos alertas.
# Para obter IDs: Discord → Configurações → Avançado →
# Modo Desenvolvedor → Clicar no cargo → Copiar ID
ROLE_SUPORTE=
ROLE_RELACIONAMENTO=
ROLE_IMPLANTACAO=
ROLE_MARKETING=
